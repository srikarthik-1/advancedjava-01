import java.util.*;

class primenumber{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        System.out.print("enter number : ");
        int n = sc.nextInt();
        System.out.println("prime numbers : ");
        for(int i = 2 ; i<=n ; i++){
            int count = 0;
            for(int j = 1;j<=i;j++){
                if(i%j==0){
                    count++;
                }
            } 
            if(count==2){
                System.out.print(i+" ");
            }
        }
    }
}
